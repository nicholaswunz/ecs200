model <- aov(yield ~ Location * treatment, data = data)
summary(model)
plot(model)
shapiro.test(residuals(model))
hist(data$yield)
hist(data$Location)
hist(data$treatment)
data
hist(data$yield)
summary(model)
TukeyHSD(model)
data
summary(data)
ggplot(data,
aes(x = treatment,
y = yield,
fill = Location)) +
stat_summary(
fun = mean,
geom = "bar",
position = "dodge"
) +
stat_summary(
fun.data = mean_se,
geom = "errorbar",
position = position_dodge(width = 0.9),
width = 0.2
) +
labs(
title = "Effect of Nutrient Treatment and Climate on Biomass Yield",
x = "Treatment",
y = "Mean Biomass Yield (g)"
) +
theme_minimal()
ggplot(data,
aes(x = treatment,
y = yield,
fill = Location)) +
geom_boxplot() +
labs(
title = "Distribution of Biomass Yield",
x = "Treatment",
y = "Biomass Yield (g)"
) +
theme_minimal()
ggplot(data,
aes(x = treatment,
y = yield,
colour = Location,
group = Location)) +
stat_summary(fun = mean, geom = "line") +
stat_summary(fun = mean, geom = "point", size = 3) +
labs(
title = "Interaction Plot",
x = "Treatment",
y = "Mean Biomass Yield"
) +
theme_minimal()
summary(model)
