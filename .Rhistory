library(tidyverse)
## bring the libraries into R
library(tidyverse)
# Load data
# Load a CSV file
plant_task_clean_data <- read_csv("https://raw.githubusercontent.com/nicholaswunz/ECS200-Workshop/refs/heads/main/data/plant_calcium_task.csv") %>%
dplyr::mutate(watershed = recode(watershed, "W2" = "W1"),
watershed = as.factor(watershed),
transect  = as.factor(transect)) %>%
dplyr::filter(stem_dry_mass < 1)
plant_task_clean_data
plant_task_clean_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point()
# Load data
plant_test_data <- read_csv("https://raw.githubusercontent.com/nicholaswunz/ECS200-Workshop/refs/heads/main/data/plant_calcium_task.csv") %>%
dplyr::mutate(watershed = recode(watershed, "W2" = "W1"),
watershed = as.factor(watershed),
transect  = as.factor(transect)) %>%
dplyr::filter(stem_dry_mass < 1 & year == 2004)
plant_task_clean_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point()
View(plant_task_clean_data)
plant_test_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point()
plant_test_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point() + # points for a scatterplot
labs(title = "Scatterplot of stem length and stem dry mass in 2004",
x = "Stem length (cm)",
y = "Stem dry mass (g)") +
theme_bw()
## Run an initial the model
stem_lm <- lm(stem_dry_mass ~ stem_length , data = plant_test_data)
## Secondly create a set of visualisations that help us understand the diagnostics
### Get several key outputs including:
### - fitted values (.fitted)
### - standardised residuals (.std.resid)
### - leverage (.hat)
stem_aug <- augment(stem_lm)
# install.packages("broom") To install broom package if not installed.
## bring the libraries into R
library(tidyverse)
library(broom)
# Load data
plant_test_data <- read_csv("https://raw.githubusercontent.com/nicholaswunz/ECS200-Workshop/refs/heads/main/data/plant_calcium_task.csv") %>%
dplyr::mutate(watershed = recode(watershed, "W2" = "W1"),
watershed = as.factor(watershed),
transect  = as.factor(transect)) %>%
dplyr::filter(stem_dry_mass < 1 & year == 2004)
## Run an initial the model
stem_lm <- lm(stem_dry_mass ~ stem_length , data = plant_test_data)
## Secondly create a set of visualisations that help us understand the diagnostics
### Get several key outputs including:
### - fitted values (.fitted)
### - standardised residuals (.std.resid)
### - leverage (.hat)
stem_aug <- broom::augment(stem_lm)
ggplot(stem_aug, aes(x = .fitted, y = .std.resid)) +
geom_point() +
theme_bw() +
geom_hline(yintercept  = 0)+
geom_hline(yintercept  = c(-2, 2), linetype  =3) +
labs(title = "Fitted values versus standardised residuals",
x = "Fitted values",
y = "Standardised residuals")
ggplot(stem_aug, aes(sample = .std.resid)) +
stat_qq() +
stat_qq_line() +
theme_minimal() +
labs(title = "QQ plot of the residuals",
x = "Theoretical Quantiles",
y = "Standardised residuals")
ggplot(stem_aug, aes(x = .hat, y = .std.resid)) +
geom_point() +
theme_minimal() +
labs(title = "Leverage versus standardised residuals",
x =  "Leverage",
y = "Standardised residuals")
## summarise the model
summary(stem_lm)
confint(stem_lm)
## visualise the model
plant_test_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point() + # points for a scatterplot
geom_smooth(method = lm, se = F) +
labs(title = "Scatterplot of stem length and stem dry mass in 2004",
x = "Stem length (cm)",
y = "Stem dry mass (g)") +
theme_bw()
## summarise the model
summary(stem_lm)
confint(stem_lm)
## visualise the model
plant_test_data %>%
ggplot(aes(x = stem_length, y = stem_dry_mass)) +
geom_point() + # points for a scatterplot
geom_smooth(method = lm, se = F, colour = "#e82c4a") +
labs(title = "Scatterplot of stem length and stem dry mass in 2004",
x = "Stem length (cm)",
y = "Stem dry mass (g)") +
theme_bw()
summary(stem_lm)
confint(stem_lm)
summary(stem_lm)
